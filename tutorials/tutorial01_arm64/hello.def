# hello.def
BootStrap: docker
From: harbor.michaelapp.com/library/ubuntu:22.04_arm64

%labels
    Author  yskj
    Version hello_v0.1

%environment

%runscript
    exec python3 /opt/app/hello.py "${@}"

%files
	./app/hello.py            /opt/app/
	./app/requirements.txt    /opt/app/

%post
    export LC_ALL="C.UTF-8"
    export DEBIAN_FRONTEND=noninteractive

    # update images source
    sed -i 's/ports.ubuntu.com/mirrors.huaweicloud.com/g' /etc/apt/sources.list
    apt update

    # install python3 and requirements.txt
    cd /opt/app
    apt install python3 python3-pip -y
    pip install -r requirements.txt -i  https://mirrors.aliyun.com/pypi/simple/

%help
    hello: singularity run hello_v0.1.sif 10 20
