# sumq.def
BootStrap: docker
From: harbor.michaelapp.com/library/octave:7.2.0

%labels
    Author  panyingyun
    Version sumqv0.1

%runscript
    cd  /opt/app/
    exec octave-cli /opt/app/main.m "${@}"

%files
    ./app/main.m     /opt/app/
    ./app/gdyadd.m   /opt/app/
    ./app/input.dat   /opt/app/

%help
    sumq: singularity run sumq_v0.1.sif  
